# =========================
# Firebase Admin
# =========================

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_WEB_API_KEY=your-web-api-key

# =========================
# OTP Configuration
# =========================

OTP_EXP_MINUTES=10

# =========================
# Frontend (CORS)
# =========================

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =========================
# Email (Resend API)
# =========================

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =========================
# Email (SMTP - DEPRECATED for OTP)
# =========================
# These SMTP variables are no longer used for OTP emails.
# OTP emails now use Resend API over HTTPS.
# If you have other features that use SMTP, keep these configured.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Your App <your-email@gmail.com>"

# =========================
# Embeddings + Vector Search
# =========================

OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=unitok-posts
PINECONE_NAMESPACE=dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# =========================
# Queue (Redis + Celery)
# =========================

REDIS_URL=redis://redis:6379/0

# =========================
# Gemini Moderation
# =========================

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
