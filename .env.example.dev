# =========================
# Firebase Admin
# =========================

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=aub-rate
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aub-rate.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40aub-rate.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# =========================
# OTP Configuration
# =========================

OTP_EXP_MINUTES=10

# =========================
# Frontend (CORS)
# =========================

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://unitok.app,https://www.unitok.app,https://unitok-rouge.vercel.app

# =========================
# Email (Resend API)
# =========================

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=auth@unitok.app

# =========================
# Email (SMTP - DEPRECATED for OTP)
# =========================
# SMTP is no longer used for OTP emails - now using Resend API over HTTPS.
# You can remove these from production, or keep them if other features use SMTP.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Your App <your-email@gmail.com>"

# =========================
# Embeddings + Vector Search
# =========================

OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=unitok-index
PINECONE_NAMESPACE=__default__
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# =========================
# Queue (Redis + Celery)
# =========================

REDIS_URL=redis://redis:6379/0

# =========================
# Gemini Moderation
# =========================

# Required key for moderation service.
GCP_GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash

# =========================
# Deploy Controls
# =========================

DEPLOY_ENV=dev
CELERY_WORKER_SCALE=4
